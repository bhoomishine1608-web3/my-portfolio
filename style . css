body {
    font-family: 'Segoe UI', Tahoma, Geneva, Verdana, sans-serif;
    margin: 0;
    padding: 0;
    background-color: #f4f7f6;
    color: #333;
    text-align: center;
}

header {
    background-color: #24292e;
    color: white;
    padding: 40px 20px;
}

h1 {
    margin: 0;
    font-size: 2.5rem;
}

section {
    max-width: 600px;
    margin: 30px auto;
    padding: 20px;
    background: white;
    border-radius: 8px;
    box-shadow: 0 4px 8px rgba(0,0,0,0.05);
}

h2 {
    color: #0366d6;
}

ul {
    list-style: none;
    padding: 0;
}

li {
    background: #e1e4e8;
    margin: 5px 0;
    padding: 10px;
    border-radius: 4px;
    display: inline-block;
    margin-right: 10px;
}

footer {
    margin-top: 50px;
    padding: 20px;
    background-color: #24292e;
    color: white;
    font-size: 0.9rem;
}
